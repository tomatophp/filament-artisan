{
    "name": "tomatophp/filament-artisan",
    "type": "library",
    "description": "Simple but yet powerful library for running some artisan commands for FilamentPHP",
    "keywords": [
        "php",
        "laravel",
        "artisan",
        "commands",
        "gui",
        "filament"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentArtisan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentArtisan\\Tests\\": "tests/src",
            "TomatoPHP\\FilamentArtisan\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentArtisan\\FilamentArtisanServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "calebporzio/sushi": "^2.5",
        "tomatophp/filament-developer-gate": "^5.0",
        "tomatophp/console-helpers": "^1.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "version": "5.0.0",
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse src --level=0",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    }
}
